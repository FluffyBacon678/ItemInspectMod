{
	"schemaVersion": 1,
	"id": "iteminspect",
	"version": "${version}",
	"name": "Item Inspect",
	"description": "Hold a key to bring your held item toward the center of the screen and tilt it with the mouse, without opening a menu or freezing movement.",
	"authors": [
		"arielg"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.arielg.iteminspect.ItemInspectClient"
		]
	},
	"mixins": [
		"iteminspect.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"mixinextras": ">=0.5.0",
		"minecraft": "1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	}
}
